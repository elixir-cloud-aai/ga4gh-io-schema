    family-names: Kanitz
    orcid: "https://orcid.org/0000-0002-3468-0652"
    affiliation: >-
      Biozentrum, University of Basel, Basel, Switzerland; SIB Swiss Institute
      of Bioinformatics, Lausanne, Switzerland
repository-code: "https://github.com/elixir-cloud-aai/ga4gh-io-schema"
url: "https://ga4gh-io-schema.readthedocs.io/"
keywords:
  - GA4GH
  - JSON Schema
  - workflows
  - WES
  - TRS
  - CWL
  - WDL
  - Nextflow
  - Snakemake
